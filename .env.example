POSTGRES_PASSWORD=replace-local-database-secret
LANGAI_DATABASE_URL=postgresql+psycopg://langai:replace-local-database-secret@localhost:55439/langai
LANGAI_REDIS_URL=redis://localhost:56379/0
LANGAI_STORAGE_BACKEND=s3
LANGAI_S3_ENDPOINT=http://localhost:59000
LANGAI_S3_BUCKET=langai-private
LANGAI_S3_ACCESS_KEY=langai-local
LANGAI_S3_SECRET_KEY=replace-local-storage-secret
LANGAI_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
LANGAI_BASE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LANGAI_MODEL_REVISION=auto
LANGAI_LOCAL_FILES_ONLY=false
LANGAI_ENABLE_EXPERIMENTAL=false
LANGAI_ARTIFACT_DIR=./data/artifacts
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
TOKENIZERS_PARALLELISM=false
